---
import { profile } from '../data/profile';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="#top" aria-label={`${profile.name}, back to top`}>
      <span class="brand-mark" aria-hidden="true">SK<span>.</span></span>
      <span class="brand-name">{profile.name}<small>{profile.role}</small></span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="#profile"><span aria-hidden="true">01</span> Profile</a>
      <a href="#contact"><span aria-hidden="true">02</span> Contact</a>
    </nav>

    <a class="header-cta" href={`mailto:${profile.email}`}>
      Let’s talk
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M4 10h11M11 5l5 5-5 5" />
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand-mark {
    display: inline-flex;
    width: 2.8rem;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.035);
    font-size: 0.9rem;
    font-weight: 750;
    letter-spacing: -0.04em;
  }

  .brand-mark span {
    color: var(--accent);
  }

  .brand-name {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .brand-name small {
    display: block;
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 450;
    letter-spacing: 0.04em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    margin-left: auto;
  }

  .site-nav a {
    color: var(--muted-light);
    font-size: 0.76rem;
    font-weight: 550;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-nav a span {
    margin-right: 0.4rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .header-cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 100vw;
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .header-cta svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 180ms ease;
  }

  .header-cta:hover {
    border-color: var(--accent);
    background: rgba(199, 255, 75, 0.06);
  }

  .header-cta:hover svg {
    transform: translateX(0.2rem);
  }

  @media (max-width: 720px) {
    .header-inner {
      min-height: 5rem;
      gap: 1rem;
    }

    .brand-name,
    .header-cta {
      display: none;
    }

    .site-nav {
      gap: 1.4rem;
    }
  }

  @media (max-width: 360px) {
    .site-nav a span {
      display: none;
    }
  }
</style>
