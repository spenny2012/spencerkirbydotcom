---
import { profile } from '../data/profile';
---

<section id="contact" class="contact-section shell" aria-labelledby="contact-title">
  <div class="contact-panel" data-reveal>
    <div class="contact-orbit" aria-hidden="true"></div>
    <div class="contact-heading">
      <p class="section-kicker">02 / Contact</p>
      <h2 id="contact-title">Let’s connect<span>.</span></h2>
      <p>Reach Spencer directly by email or phone.</p>
    </div>

    <div class="contact-links">
      <a class="email-link" href={`mailto:${profile.email}`}>
        <span>{profile.email}</span>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 25 25 7M10 7h15v15" /></svg>
      </a>
      <div class="secondary-contact">
        <a href={`tel:${profile.phoneHref}`}>
          <span class="contact-label">Phone</span>
          <span>{profile.phoneDisplay}</span>
        </a>
        <div class="location-detail">
          <span class="contact-label">Based in</span>
          <span>{profile.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-top: clamp(5rem, 10vw, 9rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .contact-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5.5rem);
    border: 1px solid var(--line-strong);
    border-radius: 1.5rem;
    background: radial-gradient(circle at 90% 10%, rgba(139, 92, 246, 0.13), transparent 36%), #0e1016;
  }

  .contact-panel::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    content: '';
    mask-image: linear-gradient(to left, black, transparent 70%);
    pointer-events: none;
  }

  .contact-orbit {
    position: absolute;
    top: -12rem;
    right: -8rem;
    width: 30rem;
    height: 30rem;
    border: 1px solid rgba(167, 139, 250, 0.13);
    border-radius: 50%;
    pointer-events: none;
  }

  .contact-orbit::before,
  .contact-orbit::after {
    position: absolute;
    inset: 3.5rem;
    border: 1px solid rgba(167, 139, 250, 0.1);
    border-radius: inherit;
    content: '';
  }

  .contact-orbit::after {
    inset: 7rem;
  }

  .section-kicker {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 560;
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  h2 span {
    color: var(--accent);
  }

  .contact-heading > p:last-child {
    margin: 1.5rem 0 0;
    color: var(--muted-light);
    font-size: 0.95rem;
  }

  .contact-links {
    position: relative;
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .email-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.7rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--text);
    font-size: clamp(1.1rem, 3.3vw, 2.6rem);
    font-weight: 450;
    letter-spacing: -0.045em;
    text-decoration: none;
  }

  .email-link span {
    overflow-wrap: anywhere;
  }

  .email-link svg {
    width: clamp(1.8rem, 4vw, 3rem);
    flex: 0 0 auto;
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.2;
    transition: transform 200ms ease;
  }

  .email-link:hover svg {
    transform: translate(0.3rem, -0.3rem);
  }

  .secondary-contact {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
    grid-template-columns: repeat(2, 1fr);
  }

  .secondary-contact > a,
  .location-detail {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .secondary-contact > a:hover > span:last-child {
    color: var(--accent);
  }

  .secondary-contact > a > span:last-child {
    transition: color 180ms ease;
  }

  .contact-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .contact-panel {
      border-radius: 1.1rem;
    }

    .email-link {
      align-items: flex-end;
      font-size: clamp(0.92rem, 4.3vw, 1.25rem);
    }

    .secondary-contact {
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }
  }
</style>
