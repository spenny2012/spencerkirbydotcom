---
import { profile } from '../data/profile';
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{profile.discipline} <span class="eyebrow-separator">/</span> {profile.location}</p>
      <h1 id="hero-title">Spencer<br /><span>Kirby</span><i>.</i></h1>
      <p class="hero-role">Senior Software Engineer</p>
      <p class="hero-intro">Fourteen years of software engineering experience, with a focus on <strong>.NET</strong> and <strong>C#</strong>.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`mailto:${profile.email}`}>
          Start a conversation
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
        </a>
        <a class="text-link" href="#profile">More about me <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="hero-visual" data-reveal style="--reveal-delay: 140ms">
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="visual-glow" aria-hidden="true"></div>
      <figure class="code-window">
        <div class="window-bar">
          <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span class="file-name">Engineer.cs</span>
          <span class="file-type">C#</span>
        </div>
        <pre><code><span class="code-keyword">var</span> engineer = <span class="code-keyword">new</span> <span class="code-type">SeniorEngineer</span>
&#123;
    Name = <span class="code-string">"Spencer Kirby"</span>,
    Focus = <span class="code-string">".NET / C#"</span>,
    Experience = <span class="code-number">14</span>,
    Location = <span class="code-string">"Camarillo, CA"</span>
&#125;;</code></pre>
        <div class="window-footer"><span>UTF-8</span><span>LF</span><span>C#</span></div>
        <figcaption class="sr-only">A C# code snippet introducing Spencer Kirby, his technology focus, experience, and location.</figcaption>
      </figure>
      <div class="experience-badge" aria-label="14 years of experience">
        <strong>14</strong>
        <span>Years of<br />experience</span>
      </div>
      <div class="tech-chip" aria-hidden="true"><span></span> .NET</div>
    </div>
  </div>

  <div class="hero-facts" data-reveal style="--reveal-delay: 220ms">
    <div><span>01 / Experience</span><strong>14 years</strong></div>
    <div><span>02 / Expertise</span><strong>.NET & C#</strong></div>
    <div><span>03 / Home base</span><strong>Camarillo, California</strong></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 10.5rem;
  }

  .hero-grid {
    display: grid;
    min-height: 36rem;
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(23rem, 0.9fr);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.7rem;
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 1rem rgba(199, 255, 75, 0.6);
  }

  .eyebrow-separator {
    color: var(--line-strong);
  }

  h1 {
    margin: 0;
    font-size: clamp(5rem, 9.2vw, 8.5rem);
    font-weight: 590;
    letter-spacing: -0.085em;
    line-height: 0.78;
  }

  h1 span {
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 241, 235, 0.72);
  }

  h1 i {
    color: var(--accent);
    font-style: normal;
  }

  .hero-role {
    margin: 2rem 0 0;
    color: var(--text);
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    font-weight: 450;
    letter-spacing: -0.025em;
  }

  .hero-intro {
    max-width: 31rem;
    margin: 0.85rem 0 0;
    color: var(--muted-light);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .hero-intro strong {
    color: var(--text);
    font-weight: 550;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.7rem;
    margin-top: 2.2rem;
  }

  .button svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted-light);
    font-size: 0.78rem;
    font-weight: 550;
    text-decoration: none;
  }

  .text-link span {
    color: var(--accent);
    transition: transform 180ms ease;
  }

  .text-link:hover {
    color: var(--text);
  }

  .text-link:hover span {
    transform: translateY(0.2rem);
  }

  .hero-visual {
    position: relative;
    display: flex;
    min-height: 29rem;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }

  .visual-glow {
    position: absolute;
    z-index: -3;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.17);
    filter: blur(4.5rem);
  }

  .orbit {
    position: absolute;
    z-index: -2;
    aspect-ratio: 1;
    border: 1px solid rgba(167, 139, 250, 0.16);
    border-radius: 50%;
  }

  .orbit::after {
    position: absolute;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--violet);
    box-shadow: 0 0 1rem rgba(167, 139, 250, 0.7);
    content: '';
  }

  .orbit-one {
    width: 110%;
  }

  .orbit-one::after {
    top: 17%;
    right: 12%;
  }

  .orbit-two {
    width: 82%;
    border-style: dashed;
    opacity: 0.75;
  }

  .orbit-two::after {
    bottom: 10%;
    left: 25%;
  }

  .code-window {
    position: relative;
    width: min(100%, 30rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 1.1rem;
    background: rgba(14, 15, 23, 0.88);
    box-shadow: 0 2.5rem 6rem rgba(0, 0, 0, 0.45), inset 0 1px rgba(255, 255, 255, 0.04);
    transform: perspective(70rem) rotateY(-4deg) rotateX(2deg);
    backdrop-filter: blur(1.5rem);
  }

  .window-bar {
    display: grid;
    min-height: 3.6rem;
    align-items: center;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    grid-template-columns: 1fr auto 1fr;
  }

  .window-dots {
    display: flex;
    gap: 0.38rem;
  }

  .window-dots span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #343640;
  }

  .window-dots span:first-child {
    background: #7950ac;
  }

  .file-name {
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .file-type {
    justify-self: end;
    color: var(--violet);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  pre {
    margin: 0;
    padding: 2rem 1.5rem 2.2rem;
    overflow-x: auto;
    color: #c6c8d2;
    font-family: var(--font-mono);
    font-size: clamp(0.64rem, 1.1vw, 0.79rem);
    line-height: 2.05;
    tab-size: 4;
  }

  .code-keyword {
    color: #c4a5fc;
  }

  .code-type {
    color: #7dd3fc;
  }

  .code-string {
    color: #d7ed9b;
  }

  .code-number {
    color: #f0abfc;
  }

  .window-footer {
    display: flex;
    justify-content: flex-end;
    gap: 1.2rem;
    padding: 0.7rem 1.2rem;
    border-top: 1px solid var(--line);
    color: #686b78;
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  .experience-badge {
    position: absolute;
    right: -0.5rem;
    bottom: 0.5rem;
    display: flex;
    width: 10.5rem;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(199, 255, 75, 0.25);
    border-radius: 0.9rem;
    background: #151820;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.35);
    animation: badge-float 6s ease-in-out infinite;
  }

  .experience-badge strong {
    color: var(--accent);
    font-size: 2.5rem;
    font-weight: 550;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .experience-badge span {
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.05em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .tech-chip {
    position: absolute;
    top: 2rem;
    left: -0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(167, 139, 250, 0.22);
    border-radius: 100vw;
    background: rgba(14, 15, 23, 0.9);
    color: #d8ccff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.25);
  }

  .tech-chip span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--violet);
  }

  .hero-facts {
    display: grid;
    margin-top: 3.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    grid-template-columns: repeat(3, 1fr);
  }

  .hero-facts div {
    display: flex;
    min-height: 7rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: 1.2rem 2rem;
  }

  .hero-facts div + div {
    border-left: 1px solid var(--line);
  }

  .hero-facts div:first-child {
    padding-left: 0;
  }

  .hero-facts span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hero-facts strong {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
  }

  @keyframes badge-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-0.55rem); }
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 9rem;
    }

    .hero-grid {
      gap: 2rem;
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
    }

    h1 {
      font-size: clamp(4.8rem, 10vw, 6.5rem);
    }

    .experience-badge {
      right: 0;
    }

    .tech-chip {
      left: 0;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 8.5rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      max-width: 38rem;
    }

    h1 {
      font-size: clamp(5rem, 21vw, 7.5rem);
    }

    .hero-visual {
      width: min(100%, 32rem);
      min-height: 27rem;
      margin: 0 auto;
    }

    .hero-facts {
      margin-top: 2rem;
    }

    .hero-facts div {
      min-height: 6.5rem;
      padding: 1rem;
    }

    .hero-facts div:first-child {
      padding-left: 0;
    }
  }

  @media (max-width: 520px) {
    .eyebrow {
      font-size: 0.57rem;
    }

    h1 {
      font-size: clamp(4.5rem, 24vw, 6.5rem);
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.3rem;
    }

    .hero-visual {
      min-height: 23rem;
    }

    .code-window {
      transform: none;
    }

    pre {
      padding: 1.6rem 1rem;
      font-size: clamp(0.57rem, 2.65vw, 0.72rem);
    }

    .experience-badge {
      bottom: -0.5rem;
      width: 9.5rem;
    }

    .tech-chip {
      top: 0;
    }

    .hero-facts {
      grid-template-columns: 1fr;
    }

    .hero-facts div {
      min-height: auto;
      padding: 1.15rem 0;
    }

    .hero-facts div + div {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
